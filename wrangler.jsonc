{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mindflow",
	"main": "worker/index.ts",
	"compatibility_date": "2025-04-01",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	/**
	 * Non-secret mail settings.
	 *
	 * RESEND_API_KEY is a secret: set it with
	 *   wrangler secret put RESEND_API_KEY
	 * MAIL_FROM must use the verified sending domain.
	 *
	 * TURNSTILE_SITE_KEY comes from Cloudflare dashboard → Turnstile → Widgets
	 * (domain: 245556.xyz). Its paired secret is a secret:
	 *   wrangler secret put TURNSTILE_SECRET_KEY
	 * The captcha stays OFF while either value is empty, so filling in the site
	 * key alone changes nothing — it switches on together with the secret.
	 * Test keys for local dev: sitekey 1x00000000000000000000AA,
	 * secret 1x0000000000000000000000000000000AA (challenge always passes).
	 */
	"vars": {
		"MAIL_FROM": "MindFlow <noreply@mail.245556.xyz>",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFthAHMQ3o5URttz"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"routes": [
		{
			"pattern": "mindflow.245556.xyz",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mindflow",
			"database_id": "29908d63-7770-41b1-8a71-cdef59985da7",
			"migrations_dir": "migrations"
		}
	]
}
