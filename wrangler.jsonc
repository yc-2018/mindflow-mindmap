{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mindflow",
	"main": "worker/index.ts",
	"compatibility_date": "2025-04-01",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	/**
	 * Non-secret mail settings.
	 *
	 * RESEND_API_KEY is a secret: set it with
	 *   wrangler secret put RESEND_API_KEY
	 * MAIL_FROM must use the verified sending domain.
	 */
	"vars": {
		"MAIL_FROM": "MindFlow <noreply@mail.245556.xyz>"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"routes": [
		{
			"pattern": "mindflow.245556.xyz",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mindflow",
			"database_id": "29908d63-7770-41b1-8a71-cdef59985da7",
			"migrations_dir": "migrations"
		}
	]
}
